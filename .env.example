# Copy to .env and fill in. Both values come from your Supabase project:
# Dashboard → Project Settings → API
#
# Only the ANON (publishable) key belongs here — it is safe in a browser bundle
# because row-level security is what actually protects the data.
# Never put the service_role key in this file.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
